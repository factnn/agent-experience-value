# Virtual environments (created locally, never committed)
.venv-audit/
.venv-train/

# Pinned upstream dataset shards (~1.7 GB) — refetch with pipeline/download_pool.py
data/

# Model weights (~7.6 GB) — refetch with pipeline/fetch_assets.py
smoke/model/

# Unpacked official BFCL package (~14 MB) — refetch with pipeline/fetch_assets.py
.third_party/

# BFCL snapshot staged during early smoke work; superseded by the official package
smoke/bfcl/
smoke/bfcl_tree.json

# Large derived tables — regenerate with pipeline/prepare_pool.py (~1.5 min, CPU only)
prepared/features.jsonl
prepared/candidate_manifest.jsonl
prepared/annotation_random200.jsonl
prepared/annotation_error100.jsonl
prepared/parse_failures20.jsonl

# Tokenized tensors — regenerate with pipeline/build_sft.py (~20 s to 2 min)
smoke/sft_*/train.pt

# LoRA weights — regenerate with pipeline/train_sft.py (~3 min to 2.5 h, 1 GPU)
# Globbed on purpose: naming individual run directories let a later run's 126 MB+ weights
# sit untracked-but-not-ignored, one `git add -A` away from being committed.
smoke/run_*/adapter/adapter_model.safetensors

# Raw audit dumps of public dataset rows — regenerate with audit/audit_pool.py
audit/*/rows_*.json
audit/*/records.json
audit/*/recovery_candidates.json
audit/upstream_tree.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Isolated RL dependencies and local checkpoints
.venv-rl/
rl/**/checkpoint-*/
rl/**/adapter/
rl/**/events.out.tfevents*
rl/**/learning_state.pt

# Common-start intervention consoles and scheduler-local artifacts
rl/bfcl_intervention_*/**/*.console.log
rl/bfcl_intervention_*.scheduler.log
rl/bfcl_intervention_*.scheduler.pid
rl/bfcl_intervention_followup_*/common
