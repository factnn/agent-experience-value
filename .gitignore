# Virtual environments (created locally, never committed)
.venv-audit/
.venv-train/

# Pinned upstream dataset shards (~1.7 GB) — refetch with pipeline/download_pool.py
data/

# Model weights (~7.6 GB) — refetch with pipeline/fetch_assets.py
smoke/model/

# Unpacked official BFCL package (~14 MB) — refetch with pipeline/fetch_assets.py
.third_party/

# BFCL snapshot staged during early smoke work; superseded by the official package
smoke/bfcl/
smoke/bfcl_tree.json

# Large derived tables — regenerate with pipeline/prepare_pool.py (~1.5 min, CPU only)
prepared/features.jsonl
prepared/candidate_manifest.jsonl
prepared/annotation_random200.jsonl
prepared/annotation_error100.jsonl
prepared/parse_failures20.jsonl

# Tokenized tensors — regenerate with pipeline/build_sft.py (~20 s)
smoke/sft_smoke/train.pt

# LoRA weights (~127 MB) — regenerate with pipeline/train_sft.py (~3 min, 1 GPU)
smoke/run_lora/adapter/adapter_model.safetensors

# Raw audit dumps of public dataset rows — regenerate with audit/audit_pool.py
audit/*/rows_*.json
audit/*/records.json
audit/*/recovery_candidates.json
audit/upstream_tree.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
